#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main(int argc, char *argv[]){
    int x, y, i, j;
    pid_t pid;

    if (argc != 3){
        printf("Error: No se han introducido los argumentos correctamente\n");
        exit(1);
    }

    x = atoi(argv[1]);
    y = atoi(argv[2]);

    if (x <= 0 || y <= 0){
        printf("Error: No se han introducido los argumentos correctamente, deben de ser mayores que cero\n");
        exit(1);
    }

    printf("Soy malla, mi PID es %d\n", getpid());

    for (j = 1; j <= y; j++){ // 'malla' genera los procesos de la primera fila
        pid = fork();

        if (pid < 0){
            perror("Error en fork");
            exit(1);
        }

        if (pid == 0){
            printf("Soy p%d%d, mi PID es %d y mi padre es %d\n",1, j, getpid(), getppid());

            // ahora el hijo continua con la columna verticalmente 
            for (i = 2; i <= x; i++){
                pid = fork();

                if (pid < 0){
                    perror("Error en fork");
                    exit(1);
                }

                if (pid > 0){ // el padre espera
                    wait(NULL);
                    exit(0);
                }
                // el hijo continua
                printf("Soy p%d%d, mi PID es %d y mi padre es %d\n",i, j, getpid(), getppid());
            }
            // para el ultimo proceso de cada columan
            sleep(20);
            exit(0);
        }
    }
    for (j = 1; j <= y; j++){ // 'malla' espera a todos los procesos de la primera fila
        wait(NULL);
    }

    printf("Soy malla (%d) y termino\n", getpid());

    exit(0);
}
