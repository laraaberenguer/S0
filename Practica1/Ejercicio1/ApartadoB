void proceso_Z(pid_t pidA, pid_t pidEjec, int segundos){
    printf("Soy el proceso Z: mi pid es %d. Mi padre es %d. Mi abuelo es %d.Mi bisabuelo es %d\n", getpid(), getppid(), pidA, pidEjec);

    signal(SIGALRM, manejador);
    signal(SIGUSR2, manejador);

    alarm(segundos);
    pause();

    kill(pidA, SIGUSR1);
    pause();

    printf("Soy Z (%d) y muero\n", getpid());

    exit(0);
}

void proceso_B(pid_t pidA, pid_t pidEjec, int segundos){
    pid_t pidX, pidY, pidZ;

    printf("Soy el proceso B: mi pid es %d. Mi padre es %d. Mi abuelo es %d\n", getpid(), getppid(), pidEjec);

    signal(SIGUSR2, manejador);

    pidX = fork();

    if (pidX == -1){
        perror("Error en fork");
        exit(1);
    }

    if (pidX == 0){
        proceso_X(pidA, pidEjec);
    }
    else {
        pidY = fork();

        if (pidY == -1){
            perror("Error en fork");
            exit(1);
        }

        if (pidY == 0){
            proceso_Y(pidA, pidEjec);
        }
        else{
            pidZ = fork();

            if (pidZ == -1){
                perror("Error en fork");
                exit(1);
            }

            if (pidZ == 0){
                proceso_Z(pidA, pidEjec, segundos);
            }
            else{
                pause();

                kill(pidZ, SIGUSR2);
                wait(NULL);

                kill(pidY, SIGUSR2);
                wait(NULL);

                kill(pidX, SIGUSR2);
                wait(NULL);

                printf("Soy B (%d) y muero\n", getpid());

                exit(0);
            }
        }
    }
}

