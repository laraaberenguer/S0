int validar_argumentos(int argc, char *argv[]){
    int segundos;

    if (argc != 2){
        printf("Error: se ha de introducir un único argumento");
        exit(1);
    }

    segundos = atoi(argv[1]);

    if (segundos <= 0){
        printf("El numero de segundos debe ser mayor que 0\n");
        exit(1);
    }

    return segundos;
}

