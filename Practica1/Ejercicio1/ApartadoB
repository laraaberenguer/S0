int main(int argc, char *argv[]){
    pid_t pidEjec, pidA;
    int segundos;

    segundos = validar_argumentos(argc, argv);

    pidEjec = getpid();

    printf("Soy el proceso ejec: mi pid es %d\n", getpid());

    pidA = fork();

    if (pidA == -1){
        perror("Error en fork");
        exit(1);
    }

    if (pidA == 0){
        proceso_A(pidEjec, segundos);
    }
