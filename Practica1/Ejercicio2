#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/wait.h>


int validar_argumentos(int argc, char *argv[]){
    int tam;

    if (argc != 3) {
        printf("Error: argumentos incorrectos\n");
        exit(1);
    }

    tam = atoi(argv[2]);

    if (tam <= 0) {
        printf("El tamano debe ser mayor que 0\n");
        exit(1);
    }

    return tam;
}


void proceso_hijo(int fdLectura, char *nombreArchivo, int numeroFragmento, int tam){
    char datos[tam];
    char nombreDestino[256];
    int fdDestino, n;
    int totalLeido = 0;

    while (totalLeido < tam){
        n = read(fdLectura, datos + totalLeido, tam - totalLeido);

        if (n == -1) {
            perror("Error al leer de la tuberia");
            exit(1);
        }

        if (n == 0) {
            printf("Error al recibir el fragmento\n");
            exit(1);
        }

        totalLeido = totalLeido + n;
    }

    sprintf(nombreDestino, "%s.h%02d", nombreArchivo, numeroFragmento);

    fdDestino = creat(nombreDestino, 0644);

    if (fdDestino == -1){
        perror("Error al crear el archivo");
        exit(1);
    }

    if (write(fdDestino, datos, totalLeido) == -1){
        perror("Error al escribir en el archivo");
        close(fdDestino);
        exit(1);
    }

    close(fdDestino);
}


void procesar_fragmento(char *buffer, int bytesLeidos, char *nombreArchivo, int numeroFragmento) {
    int tuberia[2];
    pid_t pid;

    if (pipe(tuberia) == -1){
        perror("Error al crear la tuberia");
        exit(1);
    }

    pid = fork();

    if (pid == -1){
        perror("Error en fork");
        close(tuberia[0]);
        close(tuberia[1]);
        exit(1);
    }

    if (pid == 0){ //hijo
        close(tuberia[1]);

        proceso_hijo(tuberia[0], nombreArchivo, numeroFragmento, bytesLeidos);

        close(tuberia[0]);
        exit(0);
    }
    else { //padre
        close(tuberia[0]);

        if (write(tuberia[1], buffer, bytesLeidos) == -1){
            perror("Error al escribir en la tuberia");
            close(tuberia[1]);
            exit(1);
        }

        close(tuberia[1]);
        wait(NULL);
    }
}


int main(int argc, char *argv[]) {
    int fdArchivo, tam, bytesLeidos;
    int contador = 0;

    tam = validar_argumentos(argc, argv);

    fdArchivo = open(argv[1], O_RDONLY);

    if (fdArchivo == -1){
        perror("Error al abrir el archivo");
        exit(1);
    }

    char buffer[tam];

    while ((bytesLeidos = read(fdArchivo, buffer, tam)) > 0){
        procesar_fragmento(buffer, bytesLeidos, argv[1], contador);
        contador++;
    }

    if (bytesLeidos == -1){
        perror("Error al leer el archivo");
        close(fdArchivo);
        exit(1);
    }

    close(fdArchivo);
    return 0;
}
