#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <arpa/inet.h>

#define PUERTO 9999
#define TAM 4096

void validar_argumentos(int argc) {
    if (argc != 2) {
        printf("Error: Argumentos incorrectos\n");
        exit(1);
    }
}

int conectar_servidor(char *ip) {
    int cliente;
    struct sockaddr_in direccion = {0};

    cliente = socket(AF_INET, SOCK_STREAM, 0);

    if (cliente == -1) {
        perror("Error al crear el socket");
        exit(1);
    }

    direccion.sin_family = AF_INET;
    direccion.sin_port = htons(PUERTO);
    direccion.sin_addr.s_addr = inet_addr(ip);

    if (connect(cliente, (struct sockaddr *)&direccion, sizeof(direccion)) == -1) {
        perror("Error al conectar con el servidor");
        close(cliente);
        exit(1);
    }

    return cliente;
}

int mostrar_datos(char buffer[], int tam) {
    int escritos = 0;
    int resultado;
    int correcto = 1;

    while (escritos < tam && correcto == 1) {
        resultado = write(STDOUT_FILENO, buffer + escritos, tam - escritos);

        if (resultado <= 0) {
            perror("Error al mostrar los datos");
            correcto = 0;
        } else {
            escritos += resultado;
        }
    }

    return correcto;
}

int recibir_archivo(int cliente) {
    char buffer[TAM];
    int leidos;
    int correcto = 1;

    leidos = read(cliente, buffer, TAM);

    while (leidos > 0 && correcto == 1) {
        correcto = mostrar_datos(buffer, leidos);

        if (correcto == 1) {
            leidos = read(cliente, buffer, TAM);
        }
    }

    if (correcto == 1 && leidos == -1) {
        perror("Error al recibir el archivo");
        correcto = 0;
    }

    return correcto;
}

int main(int argc, char *argv[]) {
    int cliente;
    int correcto;

    validar_argumentos(argc);

    cliente = conectar_servidor(argv[1]);

    correcto = recibir_archivo(cliente);

    close(cliente);

    if (correcto == 0) {
        return 1;
    }

    return 0;
}

